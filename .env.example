# Zerion API key — server only. Get a free key at https://developers.zerion.io
# Put the real value in .env.local (gitignored). Never prefix with VITE_.
ZERION_API_KEY=

# Vinaya log read token — server only, authenticates the development record's read of this
# repo's Vinaya log. Put the real value in .env.local (gitignored). Never prefix with VITE_.
VINAYA_LOG_READ_TOKEN=

# GitHub token — server only, optional. Raises the development record's GitHub read from the
# anonymous 60 requests/hour limit. GET only; never prefix with VITE_. The build's development
# snapshot needs it (and VINAYA_LOG_READ_TOKEN) in practice: without both it writes no snapshot.
GITHUB_TOKEN=
